# Custom Padavan build configuration for TP-Link Archer C5 v4
# Hardware target verified from the owner's router: TL_C5-V4 / MT7620.
# Toolchain path is resolved by build_firmware.sh from ROOTDIR (trunk/).

CONFIG_VENDOR=TPLINK
CONFIG_PRODUCT=MT7620
CONFIG_FIRMWARE_PRODUCT_ID="TL_C5-V4"
CONFIG_TOOLCHAIN_DIR="${ROOTDIR}/../toolchain/out"

# Preserve both radios: 2.4 GHz MT7620 and 5 GHz MT7612E.
CONFIG_FIRMWARE_WIFI2_DRIVER=2.7
CONFIG_FIRMWARE_WIFI5_DRIVER=3.0

# Network stack and VPN crypto support.
CONFIG_FIRMWARE_ENABLE_IPV6=y
CONFIG_FIRMWARE_INCLUDE_XFRM=y
CONFIG_FIRMWARE_INCLUDE_IPSET=y
CONFIG_FIRMWARE_INCLUDE_AMNEZIAWG=y

# Requested traffic filtering.
CONFIG_FIRMWARE_INCLUDE_ZAPRET2=y

# Essential management and compact image settings.
CONFIG_FIRMWARE_INCLUDE_LANG_RU=y
CONFIG_FIRMWARE_INCLUDE_VENDOR_LOGO=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_FIRMWARE_ENABLE_DNSMASQ_REGEX=y
CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y
CONFIG_FIRMWARE_INCLUDE_DROPBEAR_FAST_CODE=y
